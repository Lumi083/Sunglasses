{
  "name": "sunglasses",
  "version": "0.1.0",
  "private": true,
  "description": "A click-through dimming overlay for desktop displays",
  "author": "Lumi083",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "check": "node --check src/main.js && node --check src/preload.cjs && node --check src/settings.js",
    "build:win": "electron-builder --win portable --x64",
    "build:linux": "electron-builder --linux AppImage --x64",
    "build:mac": "electron-builder --mac dmg --universal"
  },
  "devDependencies": {
    "electron": "^38.7.2",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.lumi083.sunglasses",
    "productName": "Sunglasses",
    "directories": {
      "output": "release"
    },
    "files": [
      "src/**/*",
      "icon.png",
      "icon.svg",
      "package.json"
    ],
    "artifactName": "Sunglasses-${version}-${os}-${arch}.${ext}",
    "win": {
      "icon": "icon.png",
      "target": [
        "portable"
      ]
    },
    "linux": {
      "icon": "icon.png",
      "target": [
        "AppImage"
      ],
      "category": "Utility"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.utilities"
    }
  }
}
